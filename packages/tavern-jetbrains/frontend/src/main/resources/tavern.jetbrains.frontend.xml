<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <plugin id="org.jetbrains.plugins.terminal"/>
        <module name="intellij.terminal.frontend"/>
        <module name="tavern.jetbrains.shared"/>
    </dependencies>

    <resource-bundle>messages.TavernBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="ai.taverncode.client.onboarding.providers.v5migration.TavernMigrationService"/>
        <applicationService serviceImplementation="ai.taverncode.client.onboarding.TavernOnboardingService"/>
        <applicationService serviceImplementation="ai.taverncode.client.autocomplete.TavernAutocompleteSettingsService"/>
        <customPasteProvider implementation="ai.taverncode.client.session.ui.prompt.PromptAttachmentPasteProvider"/>
        <customPasteProvider implementation="ai.taverncode.client.session.ui.prompt.PromptTextPasteProvider"/>

        <notificationGroup id="Tavern Code"
                           displayType="BALLOON"
                           bundle="messages.TavernBundle"
                           key="notification.group.tavern"/>

        <toolWindow id="Tavern Code"
                    anchor="left"
                    icon="/icons/tavern.svg"
                    factoryClass="ai.taverncode.client.TavernToolWindowFactory"/>

        <fileEditorProvider id="TavernVfsEditor" implementation="ai.taverncode.client.vfs.TavernFileEditorProvider"/>
        <fileEditorProvider id="TavernVfsSourceEditor"
                            order="after TavernVfsEditor"
                            implementation="ai.taverncode.client.vfs.TavernSourceEditorProvider"/>
        <fileIconProvider implementation="ai.taverncode.client.vfs.TavernFileIconProvider"/>
        <fileType name="TAVERN_WORKTREE_SESSION"
                  implementationClass="ai.taverncode.client.agentManager.worktree.WorktreeSessionFileType"
                  fieldName="INSTANCE"/>

        <applicationConfigurable
                parentId="tools"
                id="ai.taverncode.jetbrains.settings"
                instance="ai.taverncode.client.settings.TavernSettingsConfigurable"
                bundle="messages.TavernBundle"
                key="settings.tavern.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.profile"
                groupWeight="5"
                instance="ai.taverncode.client.settings.profile.UserProfileConfigurable"
                bundle="messages.TavernBundle"
                key="settings.profile.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.models"
                groupWeight="4"
                instance="ai.taverncode.client.settings.models.ModelsConfigurable"
                bundle="messages.TavernBundle"
                key="settings.models.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.providers"
                groupWeight="3"
                instance="ai.taverncode.client.settings.providers.ProvidersConfigurable"
                bundle="messages.TavernBundle"
                key="settings.providers.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.marketplace"
                groupWeight="2"
                instance="ai.taverncode.client.settings.marketplace.MarketplaceConfigurable"
                bundle="messages.TavernBundle"
                key="settings.marketplace.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.agentBehavior"
                groupWeight="1"
                instance="ai.taverncode.client.settings.agents.AgentBehaviorConfigurable"
                bundle="messages.TavernBundle"
                key="settings.agentBehavior.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.context"
                groupWeight="-1"
                instance="ai.taverncode.client.settings.context.ContextConfigurable"
                bundle="messages.TavernBundle"
                key="settings.context.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.autoApprove"
                groupWeight="0"
                instance="ai.taverncode.client.settings.autoapprove.AutoApproveConfigurable"
                bundle="messages.TavernBundle"
                key="settings.autoApprove.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.checkpoints"
                groupWeight="-2"
                instance="ai.taverncode.client.settings.checkpoints.CheckpointsConfigurable"
                bundle="messages.TavernBundle"
                key="settings.checkpoints.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.integrations"
                groupWeight="-3"
                instance="ai.taverncode.client.settings.integrations.IntegrationsConfigurable"
                bundle="messages.TavernBundle"
                key="settings.integrations.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings"
                id="ai.taverncode.jetbrains.settings.advanced"
                groupWeight="-4"
                instance="ai.taverncode.client.settings.AdvancedConfigurable"
                bundle="messages.TavernBundle"
                key="settings.advanced.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings.agentBehavior"
                id="ai.taverncode.jetbrains.settings.agentBehavior.agents"
                instance="ai.taverncode.client.settings.agents.AgentsConfigurable"
                bundle="messages.TavernBundle"
                key="settings.agentBehavior.agents.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings.agentBehavior"
                id="ai.taverncode.jetbrains.settings.agentBehavior.mcp"
                instance="ai.taverncode.client.settings.agents.McpConfigurable"
                bundle="messages.TavernBundle"
                key="settings.agentBehavior.mcp.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings.agentBehavior"
                id="ai.taverncode.jetbrains.settings.agentBehavior.skills"
                instance="ai.taverncode.client.settings.agents.SkillsConfigurable"
                bundle="messages.TavernBundle"
                key="settings.agentBehavior.skills.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings.agentBehavior"
                id="ai.taverncode.jetbrains.settings.agentBehavior.commands"
                instance="ai.taverncode.client.settings.agents.CommandsConfigurable"
                bundle="messages.TavernBundle"
                key="settings.agentBehavior.commands.displayName"/>

        <applicationConfigurable
                parentId="ai.taverncode.jetbrains.settings.agentBehavior"
                id="ai.taverncode.jetbrains.settings.agentBehavior.rules"
                instance="ai.taverncode.client.settings.rules.RulesConfigurable"
                bundle="messages.TavernBundle"
                key="settings.agentBehavior.rules.displayName"/>

        <registryKey key="tavern.session.condense"
                     description="Enable event condensing in the session update queue (merges redundant snapshots before model delivery)."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="tavern.session.flushMs"
                     description="Session update queue flush cadence in milliseconds."
                     defaultValue="150"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="tavern.session.inactive.disposeTimeoutMs"
                     description="Milliseconds before hidden session UI is disposed after switching away."
                     defaultValue="180000"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="tavern.session.validateRoots"
                      description="Treat settled (non-streaming) transcript turns as Swing validate roots so their internal repaints do not relayout the whole transcript."
                      defaultValue="true"
                      restartRequired="false"
                      overrides="false"/>
        <registryKey key="tavern.diagram.inline.enabled"
                     description="Render Mermaid diagram fences inline in markdown session views."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="tavern.list.fade"
                     description="Fade list row titles and descriptions into the row background where they do not fit, instead of leaving a bare cut."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
    </extensions>

    <applicationListeners>
        <listener class="ai.taverncode.client.plugin.TavernFrontendDynamicPluginListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <action id="Tavern.Restart"
                class="ai.taverncode.client.actions.RestartTavernAction"/>

        <action id="Tavern.ReloadCoreSettings"
                class="ai.taverncode.client.actions.ReloadCoreSettingsAction"/>

        <action id="Tavern.Reinstall"
                class="ai.taverncode.client.actions.ReinstallTavernAction"/>

        <action id="Tavern.CoreInfo"
                class="ai.taverncode.client.actions.CoreInfoAction"/>

        <action id="Tavern.OpenSettings"
                class="ai.taverncode.client.actions.OpenSettingsAction"
                icon="AllIcons.General.GearPlain"/>

        <action id="Tavern.OpenUserProfileSettings"
                class="ai.taverncode.client.actions.OpenUserProfileSettingsAction"/>

        <action id="Tavern.OpenMarketplaceSettings"
                class="ai.taverncode.client.actions.OpenMarketplaceSettingsAction"/>

        <action id="Tavern.OpenLocalConfig"
                class="ai.taverncode.client.actions.OpenLocalConfigAction"/>

        <action id="Tavern.OpenGlobalConfig"
                class="ai.taverncode.client.actions.OpenGlobalConfigAction"/>

        <action id="Tavern.ForceMigration"
                class="ai.taverncode.client.actions.ForceMigrationAction"/>

        <action id="Tavern.OpenSetupScript"
                class="ai.taverncode.client.actions.OpenSetupScriptAction"/>

        <group id="Tavern.CliGroup" text="Core" popup="true">
            <reference ref="Tavern.ReloadCoreSettings"/>
            <separator/>
            <reference ref="Tavern.Restart"/>
            <reference ref="Tavern.Reinstall"/>
            <separator/>
            <reference ref="Tavern.CoreInfo"/>
        </group>

        <group id="Tavern.OpenConfigGroup" text="Config Files" popup="true">
            <reference ref="Tavern.OpenLocalConfig"/>
            <reference ref="Tavern.OpenGlobalConfig"/>
            <separator/>
            <reference ref="Tavern.ForceMigration"/>
        </group>

        <group id="Tavern.SettingsGroup">
            <reference ref="Tavern.OpenSettings"/>
            <separator/>
            <reference ref="Tavern.OpenUserProfileSettings"/>
            <reference ref="Tavern.OpenMarketplaceSettings"/>
            <separator/>
            <reference ref="Tavern.OpenConfigGroup"/>
            <separator/>
            <reference ref="Tavern.CliGroup"/>
        </group>

        <action id="Tavern.Settings"
                class="ai.taverncode.client.actions.TavernSettingsAction"
                icon="AllIcons.General.GearPlain"/>

        <action id="Tavern.NewSession"
                class="ai.taverncode.client.actions.NewSessionAction"/>

        <action id="Tavern.NewWorktree"
                class="ai.taverncode.client.actions.NewWorktreeAction"/>

        <action id="Tavern.Chat.NewWorktree"
                class="ai.taverncode.client.actions.ChatNewWorktreeAction"
                text="New Worktree"
                description="Create a new git worktree with its own branch and session"/>

        <action id="Tavern.Chat.MoveToWorktree"
                class="ai.taverncode.client.actions.ChatMoveToWorktreeAction"
                text="Move to Worktree"
                description="Move this session into a new git worktree"/>

        <action id="Tavern.History"
                class="ai.taverncode.client.actions.HistoryAction"/>

        <!-- Declarative toolbar group for the Tavern tool window title bar -->
        <group id="Tavern.ToolWindowToolbar">
            <reference ref="Tavern.NewSession"/>
            <reference ref="Tavern.NewWorktree"/>
            <reference ref="Tavern.History"/>
            <reference ref="Tavern.Settings"/>
        </group>

        <action id="Tavern.SendPrompt"
                class="ai.taverncode.client.actions.SendPromptAction"
                text="Send Prompt"
                description="Send the current Tavern prompt">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ENTER"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="meta ENTER"/>
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control ENTER"/>
        </action>

        <action id="Tavern.SubmitDialog"
                class="ai.taverncode.client.actions.SubmitDialogAction"
                text="Submit Dialog"
                description="Run the default action in the current Tavern dialog">
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="meta ENTER"/>
        </action>

        <action id="Tavern.StopSession"
                class="ai.taverncode.client.actions.StopSessionAction"
                text="Stop Session"
                description="Stop the current Tavern session">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="alt S"/>
        </action>

        <!--
          The macOS keymaps inherit from $default through MacOSDefaultKeymap, which swaps Ctrl and Cmd
          on every inherited shortcut. Ctrl+digit would therefore arrive as Cmd+digit (Cmd+1 activates
          the Project tool window), so each mac keymap re-declares the literal Ctrl shortcut with
          replace-all to drop the converted one. Same pattern the platform uses for Emmet's edit points.
        -->
        <action id="Tavern.Session.CycleMode"
                class="ai.taverncode.client.actions.CycleModeAction"
                text="Cycle Mode"
                description="Switch to the next Tavern mode">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 1"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 1"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 1"
                               replace-all="true"/>
        </action>

        <action id="Tavern.Session.CycleModel"
                class="ai.taverncode.client.actions.CycleModelAction"
                text="Cycle Model"
                description="Switch to the next favorite or recommended Tavern model">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 2"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 2"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 2"
                               replace-all="true"/>
        </action>

        <action id="Tavern.Session.CycleReasoning"
                class="ai.taverncode.client.actions.CycleReasoningAction"
                text="Cycle Reasoning Effort"
                description="Switch to the next Tavern reasoning effort">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 3"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 3"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 3"
                               replace-all="true"/>
        </action>

        <action id="Tavern.Session.ResetModel"
                class="ai.taverncode.client.actions.ResetModelAction"
                text="Reset Model"
                description="Clear the Tavern model override for the current mode">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 0"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 0"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 0"
                               replace-all="true"/>
        </action>

        <action id="Tavern.Session.Open"
                class="ai.taverncode.client.actions.OpenSessionAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ENTER"/>
        </action>

        <action id="Tavern.Session.Rename"
                class="ai.taverncode.client.actions.RenameSessionAction"
                use-shortcut-of="RenameElement"/>

        <action id="Tavern.Session.Delete"
                class="ai.taverncode.client.actions.DeleteSessionAction"
                use-shortcut-of="$Delete"/>

        <action id="Tavern.Worktree.Rename"
                class="ai.taverncode.client.actions.RenameWorktreeAction"/>

        <action id="Tavern.Worktree.Delete"
                class="ai.taverncode.client.actions.DeleteWorktreeAction"/>

        <action id="Tavern.Worktree.OpenPr"
                class="ai.taverncode.client.actions.OpenWorktreePrAction"/>

        <action id="Tavern.Worktree.CopyPrRef"
                class="ai.taverncode.client.actions.CopyWorktreePrRefAction"/>

        <action id="Tavern.Worktree.OpenDiff"
                class="ai.taverncode.client.actions.OpenWorktreeDiffAction"/>

        <action id="Tavern.Worktree.OpenLocalDiff"
                class="ai.taverncode.client.actions.OpenWorktreeLocalDiffAction"/>

        <action id="Tavern.Worktree.CopyBranchName"
                class="ai.taverncode.client.actions.CopyBranchNameAction"/>

        <action id="Tavern.Worktree.CopyBranchPath"
                class="ai.taverncode.client.actions.CopyBranchPathAction"/>

        <action id="Tavern.Worktree.RunSetupScript"
                class="ai.taverncode.client.actions.RunWorktreeSetupScriptAction"/>

        <action id="Tavern.WorktreeSession.Rename"
                class="ai.taverncode.client.actions.RenameWorktreeSessionAction"/>

        <action id="Tavern.WorktreeSession.Delete"
                class="ai.taverncode.client.actions.DeleteWorktreeSessionAction"/>

        <action id="Tavern.WorktreeSession.MoveToWorktree"
                class="ai.taverncode.client.actions.MoveWorktreeSessionAction"/>

        <action id="Tavern.WorktreeSession.Fork"
                class="ai.taverncode.client.actions.ForkWorktreeSessionAction"/>

        <group id="Tavern.Worktree.RowMenu">
            <reference ref="Tavern.Worktree.Rename"/>
            <separator/>
            <reference ref="Tavern.Worktree.OpenPr"/>
            <separator/>
            <reference ref="Tavern.Worktree.OpenDiff"/>
            <reference ref="Tavern.Worktree.OpenLocalDiff"/>
            <separator/>
            <reference ref="Tavern.Worktree.CopyBranchName"/>
            <reference ref="Tavern.Worktree.CopyBranchPath"/>
            <reference ref="Tavern.Worktree.CopyPrRef"/>
            <separator/>
            <reference ref="Tavern.OpenSetupScript"/>
            <reference ref="Tavern.Worktree.RunSetupScript"/>
            <separator/>
            <reference ref="Tavern.Worktree.Delete"/>
        </group>

        <group id="Tavern.WorktreeSession.RowMenu">
            <reference ref="Tavern.WorktreeSession.Fork"/>
            <reference ref="Tavern.WorktreeSession.MoveToWorktree"/>
            <separator/>
            <reference ref="Tavern.WorktreeSession.Rename"/>
            <reference ref="Tavern.WorktreeSession.Delete"/>
        </group>

        <group id="Tavern.History.ContextMenu">
            <reference ref="Tavern.Session.Open"/>
            <separator/>
            <reference ref="Tavern.Session.Rename"/>
            <reference ref="Tavern.Session.Delete"/>
        </group>

        <!-- Text and descriptions come from TavernBundle via action.<id>.text / .description. -->
        <action id="Tavern.Session.AutoApprove"
                class="ai.taverncode.client.actions.SessionAutoApproveAction"/>

        <action id="Tavern.Session.Fork"
                class="ai.taverncode.client.actions.ForkSessionAction"/>

        <action id="Tavern.Session.Board"
                class="ai.taverncode.client.actions.ShowSessionBoardAction"/>

        <action id="Tavern.Session.CompareToBase"
                class="ai.taverncode.client.actions.CompareToBaseAction"/>

        <action id="Tavern.Session.OpenPr"
                class="ai.taverncode.client.actions.OpenSessionPrAction"/>

        <action id="Tavern.Session.CopyPrRef"
                class="ai.taverncode.client.actions.CopySessionPrRefAction"/>

        <action id="Tavern.Session.CopyId"
                class="ai.taverncode.client.actions.CopySessionIdAction"/>

        <action id="Tavern.Session.Share"
                class="ai.taverncode.client.actions.ShareSessionAction"/>

        <action id="Tavern.Session.CopyShareLink"
                class="ai.taverncode.client.actions.CopyShareLinkAction"/>

        <!--
          Right-click menu inside a chat session. Every item resolves its context from
          SessionActionsKeys.ACTIONS (or PromptDataKeys.SEND) which SessionUi publishes, so the menu
          works from any point in the session. Items hide rather than disable when they do not apply,
          which keeps the menu short in the common case. New Worktree / Move to Worktree live only on
          the branch dock toolbar, not here.
        -->
        <group id="Tavern.Session.ContextMenu">
            <reference ref="Tavern.Session.AutoApprove"/>
            <separator/>
            <reference ref="Tavern.Session.Fork"/>
            <reference ref="Tavern.Session.Board"/>
            <separator/>
            <reference ref="Tavern.Session.CompareToBase"/>
            <reference ref="Tavern.Session.OpenPr"/>
            <reference ref="Tavern.Session.CopyPrRef"/>
            <separator/>
            <reference ref="Tavern.OpenSettings"/>
            <reference ref="Tavern.ReloadCoreSettings"/>
            <separator/>
            <reference ref="$Copy"/>
            <separator/>
            <reference ref="Tavern.Session.CopyId"/>
            <reference ref="Tavern.Session.CopyShareLink"/>
            <reference ref="Tavern.Session.Share"/>
            <separator/>
            <reference ref="Tavern.StopSession"/>
        </group>

        <!--
          Popup shown from the "more" icon in the prompt bar. Same SessionActionsKeys.ACTIONS context
          as the context menu, with Copy and Stop reserved for the right-click menu.
        -->
        <group id="Tavern.Session.PromptMenu">
            <reference ref="Tavern.Session.AutoApprove"/>
            <separator/>
            <reference ref="Tavern.Session.Fork"/>
            <reference ref="Tavern.Session.Board"/>
            <separator/>
            <reference ref="Tavern.Session.CompareToBase"/>
            <reference ref="Tavern.Session.OpenPr"/>
            <reference ref="Tavern.Session.CopyPrRef"/>
            <separator/>
            <reference ref="Tavern.OpenSettings"/>
            <reference ref="Tavern.ReloadCoreSettings"/>
            <separator/>
            <reference ref="Tavern.Session.CopyId"/>
            <reference ref="Tavern.Session.CopyShareLink"/>
            <reference ref="Tavern.Session.Share"/>
        </group>
    </actions>
</idea-plugin>
